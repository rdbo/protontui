#!/sbin/openrc-run
# OpenRC service for the protontui daemon (Alpine). Install as /etc/init.d/protontui, then
# `rc-update add protontui default`.

name="protontui"
description="Proton VPN daemon (protontui): WireGuard connection, kill switch and IPC for the TUI"
command="/usr/local/bin/protontui"
command_args="daemon"
# supervise-daemon starts the daemon again when it dies (a crash, `kill -9`). The new daemon cleans up after
# the dead connection; a standard or permanent kill switch keeps blocking meanwhile.
supervisor="supervise-daemon"
respawn_delay=2
respawn_max=10
respawn_period=300
# SIGTERM disconnects cleanly (a permanent kill switch stays armed); give the teardown time.
retry="TERM/30/KILL/5"

depend() {
	need localmount
	# Before the network comes up, so that a permanent kill switch blocks from the first packet on. The daemon
	# needs no network to start; auto-connect waits for a default route.
	before net
	# Firewall services that load a ruleset with `flush ruleset` would wipe the kill switch table: start after
	# them. (A firewall reloaded later is caught too: the daemon re-arms its tables within seconds.)
	after sysctl firewall nftables iptables ip6tables
}
